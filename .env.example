# Oracle configuration — copy this file to ".env" and fill in your values.
# The real .env is git-ignored, so your key never gets committed.

# Free Groq API key from https://console.groq.com — powers the LLM + Whisper.
GROQ_API_KEY=your_groq_api_key_here

# How Oracle refers to you. OWNER_FIRST is what it calls you out loud.
ORACLE_OWNER_NAME=Your Full Name
ORACLE_OWNER_FIRST=Sir
