# Oracle configuration — copy this file to ".env" and fill in your values.
# The real .env is git-ignored, so your key never gets committed.

# Free Groq API key from https://console.groq.com — powers the LLM + Whisper.
GROQ_API_KEY=your_groq_api_key_here

# How Oracle refers to you. OWNER_FIRST is what it calls you out loud.
ORACLE_OWNER_NAME=Your Full Name
ORACLE_OWNER_FIRST=Sir

# Optional — force a specific Groq chat model. Leave blank and Oracle picks
# the best one your account can actually use (recommended, survives Groq
# retiring model names).
GROQ_MODEL=

# Optional — set to "true" for a spoken date/reminders rundown the first time
# you wake Oracle each morning. Off by default; Jarvis stays quiet otherwise.
ORACLE_MORNING_BRIEFING=false
