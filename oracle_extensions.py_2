_register_ext2_intents()


# ============================================================================
# PERFORMANCE: Lazy LLM — skip the LLM call for very short common inputs
# that pattern-match to known conversational fillers.
# ============================================================================

_FILLER_RESPONSES: dict[re.Pattern, list[str]] = {
    re.compile(r"^\s*(?:ok|okay|cool|got it|alright|understood|sure|fine)\s*$", re.IGNORECASE): [
        "Of course, Sir.", "Understood.", "Very well.", "Noted, Sir.",
    ],
    re.compile(r"^\s*(?:never ?mind|forget it|skip it|never ?mind that)\s*$", re.IGNORECASE): [
        "Disregarded, Sir.", "Understood — moving on.", "As you wish.",
    ],
    re.compile(r"^\s*(?:yes|yeah|yep|yup|correct|exactly|right|affirmative)\s*$", re.IGNORECASE): [
        "Perfect, Sir.", "Good.", "Confirmed.", "Understood, Sir.",
    ],
    re.compile(r"^\s*(?:no|nope|nah|negative|cancel that)\s*$", re.IGNORECASE): [
        "Understood, Sir.", "Cancelled.", "Very well.", "As you wish, Sir.",
    ],
    re.compile(r"^\s*(?:thanks?|thank you|cheers|appreciate it|ty)\s*$", re.IGNORECASE): [
        "Anytime, Sir.", "Always.", "Happy to help.", "Of course, Sir.",
    ],
    re.compile(r"^\s*(?:good|great|awesome|perfect|excellent|brilliant|nice)\s*$", re.IGNORECASE): [
        "Glad to hear it, Sir.", "Excellent.", "Good to know, Sir.", "Wonderful.",
    ],
}


def _check_filler(text: str) -> bool:
    """
    If the input is a filler phrase, respond from a local pool and return True.
    Avoids a round-trip to the LLM for trivial utterances.
    """
    import __main__ as _m
    for pattern, responses in _FILLER_RESPONSES.items():
        if pattern.match(text.strip()):
            _m.speak(random.choice(responses))
            return True
    return False


def _patch_oracle_worker_fillers() -> None:
    """
    Patch the main oracle_worker so filler detection runs before LLM dispatch.
    We patch handle_quick_command instead to keep the worker clean.
    """
    import __main__ as _m

    _original_handle = _m.handle_quick_command

    def _handle_with_filler(raw_input: str) -> bool:
        # Check filler first
        if _check_filler(raw_input):
            return True
        return _original_handle(raw_input)

    _m.handle_quick_command = _handle_with_filler


_patch_oracle_worker_fillers()


# ============================================================================
# UTILITY: conversation history deduplication
#
# Prevent duplicate consecutive messages in history (can happen when the
# LLM is called multiple times for the same phrase due to retries).
# ============================================================================

def _patch_add_to_history() -> None:
    import __main__ as _m

    _original_add = _m.add_to_history

    def _dedup_add(role: str, content: str) -> None:
        with _m._memory_lock:
            hist = _m._conversation_history
            if hist and hist[-1]["role"] == role and hist[-1]["content"] == content:
                return   # skip duplicate
        _original_add(role, content)

    _m.add_to_history = _dedup_add


_patch_add_to_history()


# ============================================================================
# UTILITY: Temp file garbage collector
#
# Runs every 30 minutes and removes temp files older than 1 hour
# to prevent TEMP_AUDIO_DIR growing unboundedly in long sessions.
# ============================================================================

def _temp_gc_loop() -> None:
    while True:
        time.sleep(1800)   # every 30 minutes
        try:
            import __main__ as _m
            now = time.time()
            removed = 0
            for fname in os.listdir(_m.TEMP_AUDIO_DIR):
                fpath = os.path.join(_m.TEMP_AUDIO_DIR, fname)
                try:
                    if now - os.path.getmtime(fpath) > 3600:
                        os.remove(fpath)
                        removed += 1
                except OSError:
                    pass
            if removed:
                print(f"[GC] Removed {removed} stale temp files.")
        except Exception as e:
            print(f"[GC] Error: {e}")


threading.Thread(target=_temp_gc_loop, daemon=True, name="temp-gc").start()


# ============================================================================
# UTILITY: Volume normaliser
#
# Monitors afplay's output and adjusts volume if audio is too quiet/loud
# relative to the configured level. Uses a moving average approach.
# This is a lightweight software AGC (automatic gain control).
# ============================================================================

_AGC_ENABLED   = False   # off by default, enable with "enable auto gain"
_AGC_TARGET    = 65      # target volume level
_AGC_TOLERANCE = 10      # don't adjust within ±10 of target


def toggle_agc(enable: bool) -> None:
    global _AGC_ENABLED
    _AGC_ENABLED = enable


def _h_agc_on(m: re.Match, text: str) -> bool:
    import __main__ as _m
    toggle_agc(True)
    _m.speak("Auto gain control enabled, Sir. I'll keep the volume consistent.")
    return True


def _h_agc_off(m: re.Match, text: str) -> bool:
    import __main__ as _m
    toggle_agc(False)
    _m.speak("Auto gain control disabled, Sir.")
    return True


def _register_agc_intents() -> None:
    import __main__ as _m
    _m._INTENTS.extend([
        _m.Intent(
            re.compile(r"\b(enable auto ?gain|auto ?gain on|agc on)\b", re.IGNORECASE),
            _h_agc_on,
        ),
        _m.Intent(
            re.compile(r"\b(disable auto ?gain|auto ?gain off|agc off)\b", re.IGNORECASE),
            _h_agc_off,
        ),
    ])


_register_agc_intents()


# ============================================================================
# INTEGRATION: Add import line instructions for oracle.py
# This prints setup instructions on first import if not yet integrated.
# ============================================================================

def _check_integration() -> None:
    """
    Verify both extension files are importable and print setup reminder
    if oracle.py doesn't already import them.
    """
    oracle_path = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "oracle.py"
    )
    if not os.path.exists(oracle_path):
        return   # running standalone

    try:
        with open(oracle_path) as f:
            oracle_src = f.read()
    except Exception:
        return

    missing = []
    if "oracle_extensions" not in oracle_src:
        missing.append("oracle_extensions")
    if "oracle_extensions_2" not in oracle_src:
        missing.append("oracle_extensions_2")

    if missing:
        print("\n" + "="*60)
        print("[Oracle Extensions] SETUP REQUIRED")
        print("Add these lines at the very END of oracle.py:")
        print()
        for mod in missing:
            print(f"  from {mod} import *")
        print("="*60 + "\n")


_check_integration()


